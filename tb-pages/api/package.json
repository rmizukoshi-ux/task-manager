{
  "name": "tb-pages-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tb-pages-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tb-pages-db --remote",
    "db:create": "wrangler d1 create tb-pages-db",
    "r2:create": "wrangler r2 bucket create tb-pages-storage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.88.0"
  }
}
